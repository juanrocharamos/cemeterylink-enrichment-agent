# ============================================================
# CemeteryLink connection
# ============================================================

WP_URL=
WP_USER=
WP_APP_PASSWORD=


# ============================================================
# OpenAI
# ============================================================

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna


# ============================================================
# Geographic scope
# ============================================================

COUNTRY_NAME=United States
COUNTRY_QID=Q30
WP_COUNTRY=United States
NOMINATIM_COUNTRY_CODE=us

# Optional. If omitted, the worker generates it from COUNTRY_QID.
# SOURCE_KEY=wikidata_q30


# ============================================================
# Runtime
# ============================================================

DB_FILE=cemetery_agent_state.db
BATCH_SIZE=25

# Safe public/demo default.
# Set to 0 only when you intentionally want to process the full scope.
MAX_PEOPLE_PER_RUN=10

SLEEP_BETWEEN_BATCHES=2
SPARQL_RETRY_SECONDS=60
